{
  "index_patterns": ["network-events-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "event": {
          "properties": {
            "action":      { "type": "keyword" },
            "category":    { "type": "keyword" },
            "outcome":     { "type": "keyword" },
            "dataset":     { "type": "keyword" },
            "duration_ms": { "type": "long" }
          }
        },
        "source": {
          "properties": {
            "ip":   { "type": "ip" },
            "port": { "type": "long" },
            "bytes": { "type": "long" },
            "packets": { "type": "long" },
            "geo": {
              "properties": {
                "country_name":     { "type": "keyword" },
                "country_iso_code": { "type": "keyword" },
                "city_name":        { "type": "keyword" },
                "location":         { "type": "geo_point", "ignore_malformed": true },
                "latitude":         { "type": "float", "ignore_malformed": true },
                "longitude":        { "type": "float", "ignore_malformed": true }
              }
            }
          }
        },
        "destination": {
          "properties": {
            "ip":   { "type": "ip" },
            "port": { "type": "long" },
            "bytes": { "type": "long" },
            "packets": { "type": "long" },
            "geo": {
              "properties": {
                "country_name": { "type": "keyword" },
                "city_name":    { "type": "keyword" },
                "location":     { "type": "geo_point", "ignore_malformed": true }
              }
            }
          }
        },
        "network": {
          "properties": {
            "protocol":  { "type": "keyword" },
            "direction": { "type": "keyword" },
            "bytes":     { "type": "long" },
            "packets":   { "type": "long" }
          }
        },
        "asset": {
          "properties": {
            "name":        { "type": "keyword" },
            "criticality": { "type": "keyword" },
            "environment": { "type": "keyword" },
            "owner":       { "type": "keyword" }
          }
        },
        "http": {
          "properties": {
            "request": {
              "properties": {
                "method": { "type": "keyword" }
              }
            },
            "response": {
              "properties": {
                "status_code": { "type": "integer" }
              }
            }
          }
        },
        "url": {
          "properties": {
            "path": { "type": "keyword" }
          }
        },
        "log": {
          "properties": {
            "source": {
              "properties": {
                "type": { "type": "keyword" }
              }
            }
          }
        },
        "message": { "type": "text" }
      }
    }
  },
  "priority": 100
}
